#!/bin/sh
# pdfnative — opt-in pre-push hook.
#
# Installed with `npm run hooks:install`; removed with `npm run hooks:uninstall`.
# Runs the fast gate profile (typecheck:all, lint, test, verify:docs) before
# anything leaves the machine. CI runs the full profile afterwards.

if ! npm run gate -- --fast; then
    echo 'pre-push: the fast gate failed; nothing was pushed.' >&2
    exit 1
fi

exit 0
