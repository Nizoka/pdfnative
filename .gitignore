node_modules/
dist/
coverage/
*.log
.DS_Store
Thumbs.db
.env
.env.*
.vscode/

# Raw TTF source fonts (large binaries, downloaded by `npm run fonts:download`
# at the commit and SHA-256 pinned in fonts/SOURCES.json). Only the contents
# are ignored, so the small files no upstream URL reproduces can be committed:
# the five pyftsubset Latin subsets and four static Regular instances.
fonts/ttf/*
!fonts/ttf/NotoSans-Cyrillic.ttf
!fonts/ttf/NotoSans-Greek.ttf
!fonts/ttf/NotoSans-Polish.ttf
!fonts/ttf/NotoSans-Turkish.ttf
!fonts/ttf/NotoSans-Vietnamese.ttf
!fonts/ttf/NotoSansArabic-Regular.ttf
!fonts/ttf/NotoSansArmenian-Regular.ttf
!fonts/ttf/NotoSansGeorgian-Regular.ttf
!fonts/ttf/NotoSansHebrew-Regular.ttf

# Generated sample PDFs for visual inspection
test-output/

# Draft GitHub issues (copy-paste helpers, never committed)
release-notes/draft-*.md

# AI-agent issue drafts (HITL staging; keep README + TEMPLATE, ignore the rest)
.github/drafts/*.md
!.github/drafts/README.md
!.github/drafts/TEMPLATE.md

# Release PR description scratchpads (per-version, never committed;
# the committed template is release-notes/PR_TEMPLATE.md)
RELEASE_PR_*.md

# Claude Code per-machine settings (the shared ones are .claude/settings.json)
.claude/settings.local.json
