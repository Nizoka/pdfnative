{
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx vitest *)",
      "Bash(npx tsx scripts/*)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git check-ignore *)",
      "Bash(node -e *)"
    ],
    "deny": [
      "Read(fonts/*.js)",
      "Read(fonts/ttf/**)",
      "Read(scripts/data/*.txt)",
      "Read(package-lock.json)",
      "Read(coverage/**)",
      "Read(dist/**)",
      "Read(test-output/**)",
      "Read(node_modules/**)",
      "Read(docs/llms-full.txt)",
      "Read(docs/llms-recipes.txt)",
      "Bash(npm publish*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh pr create*)",
      "Bash(gh issue create*)",
      "Bash(gh release *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
